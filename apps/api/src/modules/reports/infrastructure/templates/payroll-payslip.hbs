<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; font-size: 11px; color: #202a35; }
    h1 { margin: 0 0 4px; font-size: 22px; color: #153b52; }
    .period { margin-bottom: 20px; color: #526371; }
    .identity { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px; padding: 12px 0; border-top: 1px solid #d6dee4; border-bottom: 1px solid #d6dee4; }
    .label { display: block; margin-bottom: 3px; color: #526371; font-size: 9px; text-transform: uppercase; }
    table { width: 100%; margin-top: 18px; border-collapse: collapse; }
    th { padding: 8px; background: #153b52; color: #fff; text-align: left; }
    td { padding: 7px 8px; border-bottom: 1px solid #d6dee4; }
    .amount { text-align: right; white-space: nowrap; }
    .totals { width: 58%; margin: 18px 0 0 auto; }
    .totals td { border: 0; }
    .net { font-size: 14px; font-weight: bold; color: #153b52; border-top: 2px solid #153b52 !important; }
    .footer { margin-top: 34px; padding-top: 10px; border-top: 1px solid #d6dee4; color: #687783; font-size: 9px; }
  </style>
</head>
<body>
  <h1>Recibo de pago</h1>
  <div class="period">Período: {{periodLabel}}</div>
  <section class="identity">
    <div><span class="label">Empleado</span>{{employeeName}}</div>
    <div><span class="label">Documento</span>{{employeeNumber}}</div>
    <div><span class="label">Departamento</span>{{departmentName}}</div>
    <div><span class="label">Cargo</span>{{positionName}}</div>
  </section>
  <table>
    <thead><tr><th>Concepto</th><th>Tipo</th><th class="amount">Monto</th></tr></thead>
    <tbody>
      {{#each lines}}
      <tr><td>{{description}}</td><td>{{type}}</td><td class="amount">{{amount}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  <table class="totals">
    <tbody>
      <tr><td>Salario base contractual</td><td class="amount">{{baseSalary}}</td></tr>
      <tr><td>Asignaciones totales</td><td class="amount">{{totalEarnings}}</td></tr>
      <tr><td>Deducciones totales</td><td class="amount">{{totalDeductions}}</td></tr>
      <tr class="net"><td>Neto a pagar</td><td class="amount">{{netPay}}</td></tr>
    </tbody>
  </table>
  <div class="footer">Documento generado el {{generatedAt}}. Este recibo corresponde al registro de nómina del período indicado.</div>
</body>
</html>

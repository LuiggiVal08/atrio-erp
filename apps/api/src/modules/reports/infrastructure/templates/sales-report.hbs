<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><style>
  body { font-family: Arial, sans-serif; font-size: 12px; color: #333; }
  h1 { color: #1a5276; border-bottom: 2px solid #1a5276; padding-bottom: 8px; }
  .period { color: #666; margin-bottom: 20px; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  th { background: #1a5276; color: #fff; padding: 8px; text-align: left; }
  td { padding: 6px 8px; border-bottom: 1px solid #ddd; }
  .total-row { font-weight: bold; background: #eaf2f8; }
  .footer { margin-top: 30px; border-top: 1px solid #ccc; padding-top: 10px; font-size: 10px; color: #999; }
</style></head>
<body>
  <h1>Reporte de Ventas</h1>
  <div class="period">{{periodLabel}}</div>
  <table>
    <thead><tr><th>Fecha</th><th>Cliente</th><th>Total</th><th>Estado</th></tr></thead>
    <tbody>
      {{#each rows}}<tr><td>{{date}}</td><td>{{client}}</td><td>{{total}}</td><td>{{status}}</td></tr>{{/each}}
    </tbody>
    <tfoot><tr class="total-row"><td colspan="3">Total General</td><td>{{grandTotal}}</td></tr></tfoot>
  </table>
  <div class="footer">Generado el {{generatedAt}}</div>
</body>
</html>

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  inactive
}

enum UserStatus {
  active
  blocked
  inactive
}

enum IdentificationType {
  CI_VE // Cédula de Identidad (Venezuela)
  RIF_VE // RIF (Venezuela)
  PASS_VE // Pasaporte (Venezuela)
  CC_CO // Cédula de Ciudadanía (Colombia)
  CE_CO // Cédula de Extranjería (Colombia)
  NIT_CO // NIT (Colombia)
  TI_CO // Tarjeta de Identidad (Colombia)
  PASS_CO // Pasaporte (Colombia)
}

enum EmployeeStatus {
  active
  inactive
}

enum EmploymentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ON_LEAVE
  TERMINATED
  ARCHIVED
}

enum ChangeType {
  RELATIONSHIP_STARTED
  CONTRACT_CREATED
  CONTRACT_RENEWED
  CONTRACT_TERMINATED
  COMPENSATION_CHANGED
  SCHEDULE_CHANGED
  STATUS_CHANGED
  POSITION_CHANGED
  RELATIONSHIP_TERMINATED
  RELATIONSHIP_SUSPENDED
  RELATIONSHIP_REACTIVATED
}

enum EmploymentReason {
  NEW_HIRE
  PROMOTION
  TRANSFER
  SALARY_REVIEW
  DISCIPLINARY_ACTION
  RESIGNATION
  LAYOFF
  RETIREMENT
  TEMPORARY_ASSIGNMENT
  CONTRACT_EXPIRATION
  MEDICAL_LEAVE
  PERSONAL_LEAVE
  ORGANIZATIONAL_RESTRUCTURE
  MERIT_INCREASE
  SCHEDULE_REVIEW
  MEDICAL_LEAVE_ENDED
  OTHER
}

enum ContractType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
  TEMPORARY
  INTERNSHIP
  PROBATION
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum ContractReason {
  RENEWAL
  EXPIRATION
  LEGAL_UPDATE
  CORRECTION
  TERMINATION
  CANCELLATION
  NEW_HIRE
  TRANSFER
  OTHER
}

enum CompensationType {
  SALARY
  BONUS
  ALLOWANCE
  COMMISSION
}

enum SubscriptionPlan {
  free
  starter
  business
  enterprise
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum DocumentType {
  sales_invoice
  purchase_order
  credit_note
  debit_note
  delivery_order
  stock_transfer
  cash_movement
}

enum DocumentStatus {
  draft
  pending_approval
  pending_fiscal
  approved
  posted
  delivered
  paid
  cancelled
}

enum CounterDocumentType {
  credit_note
  debit_note
}

enum ReportType {
  SALES
  INVENTORY
  CASH
  CLIENTS
  TAXES
  PROFIT
}

enum ReportFormat {
  PDF
  XLSX
  CSV
}

enum ReportExecutionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  documentType        DocumentType         @map("document_type")
  status              DocumentStatus       @default(draft)
  documentNumber      String               @map("document_number")
  originalDocumentId  String?              @map("original_document_id") @db.Uuid
  counterDocumentType CounterDocumentType? @map("counter_document_type")
  currency            String               @default("VED")
  exchangeRate        Decimal?             @map("exchange_rate") @db.Decimal(15, 6)
  subtotal            Decimal              @db.Decimal(15, 2)
  taxTotal            Decimal              @map("tax_total") @db.Decimal(15, 2)
  discountTotal       Decimal              @map("discount_total") @db.Decimal(15, 2)
  grandTotal          Decimal              @map("grand_total") @db.Decimal(15, 2)
  notes               String?
  rejectionReason     String?              @map("rejection_reason")
  createdById         String               @map("created_by_id") @db.Uuid
  approvedById        String?              @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?            @map("approved_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  createdBy        User            @relation(name: "document_creator", fields: [createdById], references: [id])
  approvedBy       User?           @relation(name: "document_approver", fields: [approvedById], references: [id])
  originalDocument Document?       @relation("DocumentCounterDocuments", fields: [originalDocumentId], references: [id])
  counterDocuments Document[]      @relation("DocumentCounterDocuments")
  lines            DocumentLine[]
  events           DocumentEvent[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  purchaseOrders   PurchaseOrder[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId, status])
  @@index([tenantId, documentType])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, originalDocumentId])
  @@map("documents")
}

model DocumentLine {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  lineNumber       Int      @map("line_number")
  description      String
  quantity         Decimal  @db.Decimal(15, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(15, 4)
  taxRate          Decimal  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(15, 2)
  discountRate     Decimal? @map("discount_rate") @db.Decimal(5, 2)
  discountAmount   Decimal  @map("discount_amount") @db.Decimal(15, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(15, 2)
  productId        String?  @map("product_id") @db.Uuid
  warehouseId      String?  @map("warehouse_id") @db.Uuid
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(15, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, lineNumber])
  @@map("document_lines")
}

model DocumentEvent {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  documentId     String          @map("document_id") @db.Uuid
  eventType      String          @map("event_type")
  previousStatus DocumentStatus? @map("previous_status")
  newStatus      DocumentStatus? @map("new_status")
  payload        Json?
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  document  Document @relation(fields: [documentId], references: [id])
  createdBy User     @relation("document_event_creator", fields: [createdById], references: [id])

  @@index([documentId, createdAt(sort: Desc)])
  @@index([tenantId, eventType, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("document_events")
}

model Tenant {
  id               String           @id @default(uuid()) @db.Uuid
  slug             String           @unique
  legalName        String           @map("legal_name")
  taxId            String           @unique @map("tax_id")
  baseCurrency     String           @default("VED") @map("base_currency")
  country          String           @default("VE") // Código ISO del país para motor fiscal
  timezone         String           @default("UTC")
  subscriptionPlan SubscriptionPlan @default(free) @map("subscription_plan")
  status           TenantStatus     @default(active)
  enabledModules   String[]         @default([]) @map("enabled_modules")
  settings         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  users                   User[]
  files                   File[]
  employees               Employee[]
  employeePaymentAccounts EmployeePaymentAccount[]
  roles                   Role[]
  auditLogs               AuditLog[]
  documents               Document[]
  documentEvents          DocumentEvent[]
  products                Product[]
  productCategories       ProductCategory[]
  warehouses              Warehouse[]
  branches                Branch[]
  clients                 Client[]
  vendors                 Vendor[]
  localizationTaxes       LocalizationTax[]
  currencyRates           CurrencyRate[]
  cashRegisters           CashRegister[]
  paymentMethods          PaymentMethod[]
  reportDefinitions       ReportDefinition[]
  reportExecutions        ReportExecution[]
  reportHistory           ReportHistory[]
  dashboardWidgets        DashboardWidget[]
  salesCommissions        SalesCommission[]
  invoiceTaxDetails       InvoiceTaxDetail[]
  stockTransfers          StockTransfer[]
  reorderPoints           ReorderPoint[]
  bankAccounts            BankAccount[]
  bankMovements           BankMovement[]
  departments             Department[]
  positions               Position[]
  positionAssignments     PositionAssignment[]
  employmentRelationships EmploymentRelationship[]
  payrollPeriods          PayrollPeriod[]
  payrollConcepts         PayrollConcept[]
  payrollInputs           PayrollInput[]
  employeeLoans           EmployeeLoan[]
  addresses               Address[]
  userAccess              UserAccess[]
  partners                Partner[]
  productBrands           ProductBrand[]

  @@map("tenants")
}

model UserAccess {
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String?  @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id])

  @@id([userId, tenantId])
  @@map("user_access")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  email               String
  passwordHash        String     @map("password_hash")
  name                String
  imageUrl            String?    @map("image_url")
  locale              String     @default("es")
  phone               String?
  status              UserStatus @default(active)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  employeeId          String?    @unique @map("employee_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  tenant                        Tenant                   @relation(fields: [tenantId], references: [id])
  employee                      Employee?                @relation(fields: [employeeId], references: [id])
  employeePaymentAccountChanges EmployeePaymentAccount[] @relation("EmployeePaymentAccountChangedBy")
  securityQuestions             UserSecurityQuestion[]
  userAccess                    UserAccess[]
  roles                         UserRole[]
  auditLogs                     AuditLog[]
  createdDocuments              Document[]               @relation("document_creator")
  approvedDocuments             Document[]               @relation("document_approver")
  documentEvents                DocumentEvent[]          @relation("document_event_creator")
  reportDefinitions             ReportDefinition[]       @relation("report_definition_creator")
  reportExecutions              ReportExecution[]        @relation("report_execution_requested_by")
  reportHistory                 ReportHistory[]          @relation("report_history_requested_by")
  dashboardWidgets              DashboardWidget[]        @relation("dashboard_widget_user")
  partnersCreated               Partner[]                @relation("PartnerCreatedBy")
  partnersUpdated               Partner[]                @relation("PartnerUpdatedBy")
  contactsCreated               Contact[]                @relation("ContactCreatedBy")
  contactsUpdated               Contact[]                @relation("ContactUpdatedBy")
  partnerAddressesCreated       PartnerAddress[]         @relation("PartnerAddressCreatedBy")
  partnerAddressesUpdated       PartnerAddress[]         @relation("PartnerAddressUpdatedBy")
  partnerEvents                 PartnerEvent[]           @relation("EventCreatedBy")
  uploadedFiles                 File[]                   @relation("FileUploadedBy")

  @@unique([tenantId, email])
  @@map("users")
}

model File {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  originalName   String    @map("original_name")
  storageKey     String    @unique @map("storage_key")
  mimeType       String    @map("mime_type")
  sizeBytes      BigInt    @map("size_bytes")
  checksumSha256 String    @map("checksum_sha256") @db.Char(64)
  uploadedById   String    @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy  User          @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  productFile ProductFile?
  brandLogo   ProductBrand?

  @@unique([tenantId, id])
  @@index([tenantId, deletedAt, createdAt(sort: Desc)])
  @@index([uploadedById])
  @@map("files")
}

model UserSecurityQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  position   Int
  question   String
  answerHash String   @map("answer_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@map("user_security_questions")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]
  partners PartnerCategory[]

  @@unique([tenantId, name])
  @@map("product_categories")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  sku               String    @unique
  barcode           String?
  name              String
  description       String?
  categoryId        String?   @map("category_id") @db.Uuid
  unitPrice         Float     @default(0) @map("unit_price")
  costPrice         Float     @default(0) @map("cost_price")
  brandId           String?   @map("brand_id") @db.Uuid
  baseUnit          String    @default("unidad") @map("base_unit")
  purchaseUnit      String?   @map("purchase_unit")
  conversionFactor  Float     @default(1) @map("conversion_factor")
  minStock          Float     @default(0) @map("min_stock")
  maxStock          Float?    @map("max_stock")
  reorderPoint      Float     @default(0) @map("reorder_point")
  primarySupplierId String?   @map("primary_supplier_id") @db.Uuid
  supplierSku       String?   @map("supplier_sku")
  taxId             String?   @map("tax_id") @db.Uuid
  isService         Boolean   @default(false) @map("is_service")
  imageUrl          String?   @map("image_url")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  category      ProductCategory?     @relation(fields: [categoryId], references: [id])
  brand         ProductBrand?        @relation(fields: [brandId], references: [id])
  tax           LocalizationTax?     @relation(fields: [taxId], references: [id])
  stock         Stock[]
  transfers     StockTransfer[]
  reorderPoints ReorderPoint[]
  supplierLinks ProductSupplier[]
  costHistory   ProductCostHistory[]
  lots          StockLot[]
  fileLinks     ProductFile[]

  @@unique([tenantId, id])
  @@unique([tenantId, barcode])
  @@map("products")
}

model ProductFile {
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  file    File    @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, fileId])
  @@index([tenantId, productId])
  @@map("product_files")
}

model ProductBrand {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  logoFileId String?  @map("logo_file_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  logoFile File?     @relation(fields: [tenantId, logoFileId], references: [tenantId, id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, name])
  @@unique([tenantId, logoFileId])
  @@map("product_brands")
}

model ProductSupplier {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  partnerId   String   @map("partner_id") @db.Uuid
  supplierSku String?  @map("supplier_sku")
  priority    Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([productId, partnerId])
  @@index([partnerId])
  @@map("product_suppliers")
}

model ProductCostHistory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  unitCost    Float    @map("unit_cost")
  supplierId  String?  @map("supplier_id") @db.Uuid
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt(sort: Desc)])
  @@map("product_cost_history")
}

model StockLot {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  lotNumber      String?   @map("lot_number")
  serialNumber   String?   @map("serial_number")
  expirationDate DateTime? @map("expiration_date")
  quantity       Float     @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, lotNumber])
  @@index([tenantId, expirationDate])
  @@map("stock_lots")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  code      String?
  aisle     String?
  shelf     String?
  level     String?
  bin       String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  branch            Branch?         @relation(fields: [branchId], references: [id])
  stock             Stock[]
  outgoingTransfers StockTransfer[] @relation("from_warehouse")
  incomingTransfers StockTransfer[] @relation("to_warehouse")
  reorderPoints     ReorderPoint[]
  lots              StockLot[]

  @@map("warehouses")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  warehouses Warehouse[]

  @@unique([tenantId, code])
  @@map("branches")
}

model Stock {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  quantity    Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("stock")
}

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  type          String
  quantity      Float    @default(0)
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type")
  createdAt     DateTime @default(now()) @map("created_at")
  userId        String?  @map("user_id") @db.Uuid
  lotId         String?  @map("lot_id") @db.Uuid
  balanceBefore Float?   @map("balance_before")
  balanceAfter  Float?   @map("balance_after")

  @@map("stock_movements")
}

model Address {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  country     String    @default("VE")
  state       String    @map("state")
  city        String
  addressLine String    @map("address_line")
  reference   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  clients Client[]
  vendors Vendor[]

  @@map("addresses")
}

model Client {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  documentId         String              @map("document_id")
  identificationType IdentificationType? @map("identification_type")
  legalName          String              @map("legal_name")
  firstName          String?             @map("first_name")
  middleName         String?             @map("middle_name")
  lastName           String?             @map("last_name")
  secondLastName     String?             @map("second_last_name")
  taxId              String              @map("tax_id")
  email              String?
  phone              String?
  addressId          String?             @map("address_id") @db.Uuid
  contributorType    String?             @map("contributor_type") // VE: 'formal' | 'ordinary' | 'special' | null
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  address       Address?       @relation(fields: [addressId], references: [id])
  salesInvoices SalesInvoice[]

  @@unique([tenantId, documentId])
  @@map("clients")
}

model Vendor {
  id                          String              @id @default(uuid()) @db.Uuid
  tenantId                    String              @map("tenant_id") @db.Uuid
  documentId                  String              @map("document_id")
  identificationType          IdentificationType? @map("identification_type")
  legalName                   String              @map("legal_name")
  firstName                   String?             @map("first_name")
  middleName                  String?             @map("middle_name")
  lastName                    String?             @map("last_name")
  secondLastName              String?             @map("second_last_name")
  taxId                       String              @map("tax_id")
  email                       String?
  phone                       String?
  addressId                   String?             @map("address_id") @db.Uuid
  contactFirstName            String?             @map("contact_first_name")
  contactMiddleName           String?             @map("contact_middle_name")
  contactLastName             String?             @map("contact_last_name")
  contactSecondLastName       String?             @map("contact_second_last_name")
  contactIdentificationType   IdentificationType? @map("contact_identification_type")
  contactIdentificationNumber String?             @map("contact_identification_number")

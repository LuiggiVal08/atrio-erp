  OPEN
  CALCULATING
  LOCKED
  PAID
  CLOSED
}

enum PayrollFrequency {
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY
  MONTHLY
  CUSTOM
}

enum PayrollLineType {
  EARNING
  DEDUCTION
}

enum PayrollCalculationMode {
  FIXED
  BASE_PERCENTAGE
}

enum PayrollLineSource {
  BASE
  CONCEPT
  LOAN
  COMMISSION
}


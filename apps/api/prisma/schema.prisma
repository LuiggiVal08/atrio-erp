enum PartnerType {
  PERSON
  COMPANY
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

enum PartnerRoleType {
  CUSTOMER
  SUPPLIER
  PROSPECT
  DISTRIBUTOR
  CARRIER
  MANUFACTURER
  CREDITOR
}

enum AddressType {
  FISCAL
  BILLING
  SHIPPING
  BRANCH
  PRIMARY
  OTHER
}

model Partner {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  type           PartnerType
  legalName      String        @map("legal_name")
  taxIdValue     String?       @map("tax_id_value")
  taxIdCountry   String?       @map("tax_id_country") @db.Char(2)
  taxIdType      String?       @map("tax_id_type")
  commercialName String?       @map("commercial_name")
  website        String?
  paymentTerms   String?       @map("payment_terms")
  deliveryDays   Int?          @map("delivery_days")
  status         PartnerStatus @default(ACTIVE)
  metadataSource String?       @map("metadata_source")
  metadataNotes  String?       @map("metadata_notes")
  externalId     String?       @map("external_id")
  createdById    String        @map("created_by_id") @db.Uuid
  updatedById    String        @map("updated_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  roles            PartnerRole[]
  tags             PartnerTag[]
  categories       PartnerCategory[]
  contacts         Contact[]
  addresses        PartnerAddress[]
  events           PartnerEvent[]

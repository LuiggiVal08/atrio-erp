# Database (local dev — connect direct to postgres)
DATABASE_URL=postgresql://atrio:atrio_dev_pass@localhost:5432/atrio_erp?schema=public
# Database (docker compose — connect via pgbouncer pooler)
# DATABASE_URL=postgresql://atrio:atrio_dev_pass@pgbouncer:5432/atrio_erp?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# App
PORT=3000
NODE_ENV=development
